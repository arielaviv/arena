{
  "name": "arena",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write .",
    "ci": "biome ci . && tsc --noEmit && tsc --noEmit -p src/server/tsconfig.json && vitest run && vite build",
    "server:dev": "wrangler dev",
    "server:deploy": "wrangler deploy"
  },
  "dependencies": {
    "postprocessing": "^6.39.5",
    "three": "^0.186.1",
    "zzfx": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/workers-types": "5.20261019.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/three": "^0.186.0",
    "playwright-core": "1.56.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wrangler": "4.151.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
